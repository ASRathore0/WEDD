<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive hidden files like .env
    <Files ~ "^\.">
        Order allow,deny
        Deny from all
    </Files>

    # Forward all traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
